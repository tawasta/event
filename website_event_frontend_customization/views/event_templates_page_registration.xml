    >
        <xpath expr="//div[@id='o_wevent_tickets_collapse']/div" position="attributes">
            <attribute
                name="t-att-class"
            >'row px-3 py-3 mx-0 bg-light border-bottom d-none' if not ticket.is_launched() or ticket.is_expired else 'row px-3 py-3 mx-0 bg-light border-bottom'</attribute>
        </xpath>
    </template> -->
  <template
    id="hide_share_box"
    inherit_id="website_event.event_description_full"
    active="False"
    customize_show="True"
    name="Hide share box"
  >
    <xpath expr="//div[@class='o_wevent_sidebar_block'][last()]" position="attributes">
      <attribute name="class">o_wevent_sidebar_block d-none</attribute>
    </xpath>
  </template>
  <!-- Event confirmation -->
  <template
    id="hide_ticket_ref"
    inherit_id="website_event.registration_complete"
    active="True"
    customize_show="True"
    priority="99"
    name="Hide attendee's ticket reference from registration complete view"
  >
    <xpath
      expr="//div[@class='d-flex flex-column justify-content-between flex-lg-row']//span[last()]"
      position="replace"
    >
      <span>
        <i class="fa fa-ticket mr-2" />
        <t t-if="attendee.event_ticket_id" t-esc="attendee.event_ticket_id.name" />
        <t t-else="">N/A</t>
      </span>
    </xpath>
  </template>

  <template
    id="hide_ticket_download"
    inherit_id="website_event.registration_complete"
    active="False"
    customize_show="True"
    priority="99"
    name="Hide 'Download Tickets' from registration complete view"
  >
    <xpath expr="//div[@t-if='attendees']" position="attributes">
      <attribute name="t-if" add="False" separator=" and " />
    </xpath>
  </template>

</odoo>
