#. module: website_event_time_visibility
#: model:ir.model,name:website_event_time_visibility.model_event_event
msgid "Event"
msgstr "Tapahtuma"

#. module: website_event_time_visibility
#: model:ir.model.fields,field_description:website_event_time_visibility.field_event_event__show_time_on_website
msgid "Show Time on Website"
msgstr "Näytä kellonaika verkkosivulla"

#. module: website_event_time_visibility
#: model:ir.model.fields,help:website_event_time_visibility.field_event_event__show_time_on_website
msgid ""
"Show the time of day for the start and end date on the website, in "
"addition to the dates themselves. Disable this for e.g. self-paced online "
"courses that start at a specific time but have no fixed end time of day."
msgstr ""
"Näytä alkamis- ja päättymispäivän kellonaika verkkosivulla, päivämäärien "
"lisäksi. Poista tämä käytöstä esimerkiksi verkkokursseilta, jotka alkavat "
"tiettynä kellonaikana mutta joilla ei ole kiinteää päättymiskellonaikaa."
