#. module: website_event_sale_go_to_payment_button_configurable_label
#: model:ir.model.fields,help:website_event_sale_go_to_payment_button_configurable_label.field_res_config_settings__event_registration_button_text
msgid ""
"Enter a custom label for the 'Confirm Registration' button shown during "
"event registration."
msgstr ""
"Anna mukautettu teksti 'Vahvista ilmoittautuminen' -painikkeelle, joka näytetään tapahtuman ilmoittautumisen yhteydessä."

#. module: website_event_sale_go_to_payment_button_configurable_label
#: model_terms:ir.ui.view,arch_db:website_event_sale_go_to_payment_button_configurable_label.res_config_settings_view_form
msgid ""
"Enter a custom label for the 'Confirm Registration' button shown during "
"event registration. Leave empty to use the default text."
msgstr ""
"Anna mukautettu teksti 'Vahvista ilmoittautuminen' -painikkeelle tapahtuman ilmoittautumisen yhteydessä. Jätä tyhjäksi käyttääksesi oletustekstiä."

#. module: website_event_sale_go_to_payment_button_configurable_label
#: model:ir.model.fields,help:website_event_sale_go_to_payment_button_configurable_label.field_res_config_settings__event_payment_button_text
msgid ""
"Enter a custom label for the 'Go to Payment' button shown during event "
"registration."
msgstr ""
"Anna mukautettu teksti 'Siirry maksamaan' -painikkeelle, joka näytetään tapahtuman ilmoittautumisen yhteydessä."

