<?xml version="1.0" ?>
<odoo noupdate="1">
  <!-- Email sent when a registration joins the waiting list -->
  <record id="event_waiting" model="mail.template">
    <field name="name">Event: Waiting List Confirmation</field>
    <field name="model_id" ref="event.model_event_registration" />
    <field
      name="subject"
    >You're on a waiting list for {{ object.event_id.name }}</field>
    <field
      name="email_from"
    >{{ (object.event_id.organizer_id.email_formatted or object.event_id.user_id.email_formatted or '') }}</field>
    <field
      name="email_to"
    >{{ (object.email and '"%s" &lt;%s&gt;' % (object.name, object.email) or object.partner_id.email_formatted or '') }}</field>
    <field
      name="lang"
    >{{ object.partner_id.lang or object.visitor_id.lang_id.code }}</field>
    <field name="body_html" type="html">
      <table
        border="0"
        cellpadding="0"
        cellspacing="0"
        style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
      >
        <t
          t-set="email_secondary_color"
          t-value="object.event_id.company_id and object.event_id.company_id.email_secondary_color or '#875A7B'"
        />
        <tr>
          <td align="center">
            <table
              border="0"
              cellpadding="0"
              cellspacing="0"
              width="590"
              style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;"
            >
              <tbody>
                <!-- HEADER -->
                <tr>
                  <td align="center" style="min-width: 590px;">
                    <table
                      width="590"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                    >
                      <tr>
                        <td valign="middle">
                          <span
                            style="font-size: 10px;"
                          >Your registration to waiting list</span>
                          <br />
                          <span style="font-size: 20px; font-weight: bold;">
                            <t t-out="object.name or ''" />
                          </span>
                        </td>
                        <td valign="middle" align="right">
                          <t t-if="object.event_id.is_published">
                            <a
                              t-att-href="object.event_id.website_url"
                              t-attf-style="padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #{email_secondary_color}; border-radius:3px"
                            >View Event</a>
                          </t>
                          <t t-else="">
                            <img
                              t-attf-src="/logo.png?company=#{object.company_id.id}"
                              style="padding: 0px; margin: 0px; height: auto; width: 80px;"
                              t-att-alt="object.company_id.name"
                            />
                          </t>
                        </td>
                      </tr>
                      <tr>
                        <td colspan="2" style="text-align:center;">
                          <hr
                            width="100%"
                            style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;"
                          />
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <!-- CONTENT -->
                <tr>
                  <td align="center" style="min-width: 590px;">
                    <table
                      width="590"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                    >
                      <tr>
                        <td valign="top" style="font-size: 14px;">
                          <div>
                        Hello <t t-out="object.name or ''" />,<br /><br />
                        Thank you for your interest in our event.<br />
                        <t t-if="object.event_ticket_id">
                            The ticket <strong
                            t-out="object.event_ticket_id.name"
                          /> for event
                        </t>
                        <t t-else="">
                            The event
                        </t>
                        <t t-if="object.event_id.is_published">
                            <strong>
                              <a
                                t-att-href="object.event_id.website_url"
                                t-attf-style="color:#{email_secondary_color};text-decoration:underline;"
                                t-out="object.event_id.name"
                              />
                            </strong>
                          </t>
                        <t t-else="">
                            <strong t-out="object.event_id.name" />
                          </t>
                        is currently sold out.<br />
                        You have been placed on a waiting list. We will contact you if any seats become available.<br
                          /><br />
                    </div>
                          <div>
                        To cancel your position in the waiting list follow the link below:<br
                          />
                        <div style="margin: 16px 0px 16px 0px;">
                            <a
                              t-att-href="object.waiting_list_manage_url"
                              t-attf-style="background-color: #{email_secondary_color}; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;"
                            >Cancel registration</a>
                          </div>
                    </div>
                          <div>
                        Thank you,<br />
                        <span style="color: #454748;">
                            -- <br />
                            <t t-if="object.event_id.organizer_id">
                            <t t-out="object.event_id.organizer_id.name" />
                          </t>
                            <t t-else="">
                                The <t t-out="object.event_id.name" /> Team
                            </t>
                        </span>
                    </div>
                        </td>
                      </tr>
                      <tr>
                        <td style="text-align:center;">
                          <hr
                            width="100%"
                            style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                          />
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
        <!-- FOOTER -->
        <tr>
          <td align="center" style="min-width: 590px;">
            <t t-if="object.company_id">
              <table
                width="590"
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="min-width: 590px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;"
              >
                <tr>
                  <td style="text-align: center; font-size: 14px;">
                Sent by <a
                    target="_blank"
                    t-att-href="object.company_id.website"
                    t-attf-style="color: #{email_secondary_color};"
                    t-out="object.company_id.name"
                  />
                <t t-if="object.event_id.is_published">
                    <br />Discover <a
                    href="/event"
                    style="text-decoration:none;color:#717188;"
                  >all our events</a>.
                </t>
            </td>
                </tr>
              </table>
            </t>
          </td>
        </tr>
      </table>
    </field>
  </record>

  <!-- Email sent when a seat opens up for an eligible waiting registration -->
