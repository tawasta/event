<?xml version="1.0" ?>
<odoo>
    <template id="portal_my_events" name="My events">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Events</t>
            </t>

            <div class="container portal_my_events my-4">
                <t t-if="not registrations">
                    <div class="alert alert-info">
                        There are currently no registrations for your account.
                    </div>
                </t>

                <t t-if="registrations">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-body p-0">
                            <t t-call="portal.portal_table">
                                <thead>
                                    <tr class="active">
                                        <th class="table-header-event">Event</th>
                                        <th
                                            class="table-header-details"
                                        >Registration details</th>
                                        <th
                                            class="table-header-action text-end"
                                        >Actions</th>
                                    </tr>
                                </thead>

                                <t
                                    t-foreach="grouped_registrations"
                                    t-as="registrations_group"
                                >
                                    <tbody t-if="registrations_group">
                                        <tr
                                            t-if="groupby != 'none'"
                                            class="table-light"
                                        >
                                            <th colspan="3">
                                                <t t-if="groupby == 'event'">
                                                    <span
                                                        t-if="registrations_group[0].event_id"
                                                        t-field="registrations_group[0].event_id.name"
                                                    />
                                                    <span t-else="">No Event</span>
                                                </t>
                                                <t t-if="groupby == 'ticket'">
                                                    <span
                                                        t-if="registrations_group[0].event_ticket_id"
                                                        t-field="registrations_group[0].event_ticket_id.name"
                                                    />
                                                    <span t-else="">No Ticket</span>
                                                </t>
                                                <t t-if="groupby == 'state'">
                                                    <span
                                                        t-field="registrations_group[0].state"
                                                    />
                                                </t>
                                                <t t-if="groupby == 'event_status'">
                                                    <span
                                                        t-if="event_status_data.get(registrations_group[0].event_id.id)"
                                                        t-esc="event_status_data.get(registrations_group[0].event_id.id).get('label')"
                                                    />
                                                </t>
                                            </th>
                                        </tr>

                                        <t t-foreach="registrations_group" t-as="re">
                                            <tr>
                                                <!-- EVENT -->
                                                <td
                                                    class="table-cell-event align-middle text-wrap"
                                                >
                                                    <div
                                                        class="d-flex flex-column gap-1"
                                                    >
                                                        <div
                                                            class="fw-semibold text-wrap"
                                                        >
                                                            <a
                                                                t-attf-href="/event/{{re.event_id.id}}/register"
                                                                t-att-title="re.event_id.name"
                                                                class="text-decoration-none"
                                                            >
                                                                <t
                                                                    t-if="re.event_id.name != '/'"
                                                                    t-esc="re.event_id.name"
                                                                />
                                                            </a>
                                                        </div>

                                                        <div
                                                            class="small text-muted text-wrap"
                                                        >
                                                            <i
                                                                class="fa fa-calendar me-1"
                                                            />
                                                            <span
                                                                t-field="re.event_id.date_begin"
                                                                t-options='{"widget": "datetime", "format": "short"}'
                                                            />
                                                            <span class="mx-1">-</span>
                                                            <span
                                                                t-field="re.event_id.date_end"
                                                                t-options='{"widget": "datetime", "format": "short"}'
                                                            />
                                                        </div>

                                                        <t
                                                            t-if="event_status_data.get(re.event_id.id)"
                                                        >
                                                            <div class="small mt-1">
                                                                <span
                                                                    t-attf-class="badge #{event_status_data.get(re.event_id.id).get('class')}"
                                                                    t-esc="event_status_data.get(re.event_id.id).get('label')"
                                                                />
                                                            </div>
                                                        </t>

                                                        <t
                                                            t-if="re.event_ticket_id and re.event_ticket_id.name"
                                                        >
                                                            <div
                                                                class="small text-muted text-wrap mt-1"
                                                            >
                                                                <i
                                                                    class="fa fa-ticket me-1"
                                                                    aria-hidden="true"
                                                                />
                                                                <span
                                                                    class="text-wrap text-break"
                                                                    t-field="re.event_ticket_id.name"
                                                                />
                                                            </div>
                                                        </t>
                                                    </div>
                                                </td>

                                                <!-- DETAILS -->
                                                <td
                                                    class="table-cell-details align-middle"
                                                >
                                                    <div
                                                        class="d-flex flex-column gap-2"
                                                    >
                                                        <div>
                                                            <t
                                                                t-if="re.state == 'open'"
                                                            >
                                                                <span
                                                                    class="badge text-bg-info"
                                                                >Confirmed</span>
                                                            </t>
                                                            <t
                                                                t-if="re.state == 'draft'"
                                                            >
                                                                <span
                                                                    class="badge text-bg-secondary"
                                                                >Unconfirmed</span>
                                                            </t>
                                                            <t
                                                                t-if="re.state == 'done'"
                                                            >
                                                                <span
                                                                    class="badge text-bg-success"
                                                                >Attended</span>
                                                            </t>
                                                            <t
                                                                t-if="re.state == 'cancel'"
                                                            >
                                                                <span
                                                                    class="badge text-bg-warning"
                                                                >Cancelled</span>
                                                            </t>
                                                        </div>

                                                        <div class="small text-muted">
                                                            <div>
                                                                <span
                                                                    class="fw-semibold text-body"
                                                                >Registered:</span>
                                                                <span
                                                                    t-field="re.create_date"
                                                                    t-options='{"widget": "datetime", "format": "short"}'
                                                                />
                                                            </div>

                                                            <t
                                                                t-if="re.visitor_id and re.visitor_id.sudo().partner_id"
                                                            >
                                                                <div>
                                                                    <span
                                                                        class="fw-semibold text-body"
                                                                    >Booker:</span>
                                                                    <span
                                                                        t-field="re.visitor_id.sudo().partner_id.name"
                                                                    />
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </td>

                                                <!-- ACTIONS -->
                                                <td
                                                    class="table-cell-action align-middle text-end"
                                                >
                                                    <div
                                                        class="d-flex flex-column justify-content-end align-items-end gap-2"
                                                    >
                                                        <t
                                                            t-if="re.state not in ('cancel', 'done') and re.event_id.able_to_cancel"
                                                        >
                                                            <button
                                                                type="button"
                                                                class="btn btn-outline-danger btn-sm"
                                                                t-att-data-registration-id="re.id"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#cancelModal"
                                                            >
                                                                <i
                                                                    class="fa fa-fw fa-times-circle me-1"
                                                                />
                                                                Cancel registration
                                                            </button>
                                                        </t>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>

                <div
                    id="cancelModal"
                    class="modal fade"
                    tabindex="-1"
                    aria-labelledby="cancel_registration_title"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title" id="cancel_registration_title">
                                    Cancel a registration
                                </h4>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                />
                            </div>
                            <div class="modal-body">
                                <p>
                                    You are about to <strong>cancel</strong>
                                    <span
                                        id="cancel_registration_object"
                                    >a registration</span>.
                                </p>
                                <p>Are you sure you want to continue?</p>

                                <input
                                    type="hidden"
                                    id="cancel_registration_id"
                                    name="cancel_registration_id"
                                />
                            </div>
                            <div class="modal-footer">
                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal"
                                >
                                    Keep registration
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-danger delete-confirm"
                                >
                                    Cancel registration
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
