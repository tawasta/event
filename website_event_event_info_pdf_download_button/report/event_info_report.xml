<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_event_info" model="ir.actions.report">
        <field name="name">Event Information</field>
        <field name="model">event.event</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >website_event_event_info_pdf_download_button.report_event_info</field>
        <field
            name="report_file"
        >website_event_event_info_pdf_download_button.report_event_info</field>
        <field
            name="print_report_name"
        >'Event Info - %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="event.model_event_event" />
        <field name="binding_type">report</field>
    </record>
</odoo>
