<?xml version="1.0" ?>
<odoo>
  <!-- EVENT.TYPE VIEWS -->
  <record id="view_event_type_form_cancel" model="ir.ui.view">
    <field name="name">event.type.form.cancel</field>
    <field name="model">event.type</field>
    <field name="inherit_id" ref="event.view_event_type_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='has_seats_limitation']/parent::div" position="after">
        <label for="has_cancel" string="Allow Cancellation" />
        <div>
          <field name="has_cancel" />
          <span invisible="not has_cancel">
            until <field name="cancel_interval_nbr" class="oe_inline" />
            <field name="cancel_interval_unit" class="oe_inline" />
            before the event starts
          </span>
        </div>
      </xpath>
    </field>
  </record>
  <!-- EVENT.EVENT VIEWS -->
  <record id="view_event_form_cancel" model="ir.ui.view">
    <field name="name">event.event.form.cancel</field>
    <field name="model">event.event</field>
    <field name="inherit_id" ref="event.view_event_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//group[@name='right_event_details']//field[@name='seats_limited']/parent::div"
        position="after"
      >
        <label for="has_cancel" string="Allow Cancellation" />
        <div>
          <field name="has_cancel" />
          <span invisible="not has_cancel">
            until <field name="cancel_interval_nbr" class="oe_inline" />
            <field name="cancel_interval_unit" class="oe_inline" />
            before the event starts
          </span>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
