<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <record id="event_activation_internal_group_mail" model="mail.template">
        <field name="name">Event: Activation Notification to Internal Group</field>
        <field name="model_id" ref="event.model_event_event" />
        <field
            name="subject"
        >{{ object.company_id.name or '' }}: Event Activated '{{ object.name or '' }}'</field>
        <field
            name="email_from"
        >{{ object.company_id.email or 'no-reply@example.com' }}</field>
        <field
            name="description"
        >Notify internal group members when an event is activated.</field>
        <field name="body_html" type="html">
            <p>Hello,</p>
            <p>The event <strong><t t-out="object.name or ''">Event Name</t></strong>
                has just been activated.</p>
            <ul>
                <li>Organizer: <t
                        t-out="object.organizer_id.name or '-'"
                    >Organizer</t></li>
                <li>Location: <t
                        t-out="object.address_id.city or '-'"
                    >Location</t></li>
                <li>Start Date: <t
                        t-out="format_datetime(object.date_begin, dt_format='dd.MM.yyyy HH:mm')"
                    >Date Begin</t></li>
                <li>End Date: <t
                        t-out="format_datetime(object.date_end, dt_format='dd.MM.yyyy HH:mm')"
                    >Date End</t></li>
            </ul>
            <p>Best regards,<br />
                <t t-out="object.company_id.name or ''">Company</t></p>
        </field>
    </record>

    <record id="event_ticket_sale_start_mail" model="mail.template">
        <field name="name">Event: Ticket Sale Starts Today</field>
        <field name="model_id" ref="event.model_event_event" />
        <field
            name="subject"
        >Ticket sale starts today '{{ object.name or '' }}'</field>
        <field
            name="email_from"
        >{{ object.company_id.email or 'no-reply@example.com' }}</field>
        <field name="description">Ticket sale starts today.</field>
        <field name="body_html" type="html">
            <p>Hello,</p>
            <p>The ticket sale for the event <strong><t
                        t-out="object.name or ''"
                    >Event Name</t></strong> starts today.</p>
            <ul>
                <li>Start Date: <t
                        t-out="format_datetime(object.date_begin, dt_format='dd.MM.yyyy HH:mm')"
                    >Date Begin</t></li>
                <li>Location: <t
                        t-out="object.address_id.city or '-'"
                    >Location</t></li>
                <li>Organizer: <t
                        t-out="object.organizer_id.name or '-'"
                    >Organizer</t></li>
            </ul>
            <p>Best regards,<br />
                <t t-out="object.company_id.name or ''">Company</t></p>
        </field>
    </record>

</odoo>
