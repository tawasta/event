<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- A privilege of its own: in the core Events privilege the groups are
         mutually exclusive, and the notification group is an add-on to them. -->
    <record id="res_groups_privilege_event_notifications" model="res.groups.privilege">
        <field name="name">Event Notifications</field>
        <field name="sequence">19</field>
        <field name="category_id" ref="base.module_category_marketing" />
    </record>

    <record id="group_event_notifications" model="res.groups">
        <field name="name">Event Notifications</field>
        <field
            name="privilege_id"
            ref="event_active_notify.res_groups_privilege_event_notifications"
        />
    </record>

</odoo>
