<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_project_project_form_inherit_event_link" model="ir.ui.view">
        <field name="name">project.project.form.inherit.event.link</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Events">
                    <group>
                        <field name="event_count" readonly="1" />
                    </group>
                    <field name="event_ids" context="{'default_project_id': active_id}">
                        <tree editable="bottom">
                            <field name="name" />
                            <field name="date_begin" />
                            <field name="date_end" />
                            <field name="stage_id" optional="show" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
