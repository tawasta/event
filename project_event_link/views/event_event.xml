<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_event_form_inherit_project_link" model="ir.ui.view">
        <field name="name">event.event.form.inherit.project.link</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <!-- Lisää projekti kenttä sopivaan kohtaan -->
            <field name="event_type_id" position="after">
                <field name="project_id"/>
            </field>
        </field>
    </record>

    <record id="view_event_event_tree_inherit_project_link" model="ir.ui.view">
        <field name="name">event.event.tree.inherit.project.link</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="project_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
