<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="event_type_view_form_inherit_privacy" model="ir.ui.view">
        <field name="name">event.type.view.form.inherit.privacy</field>
        <field name="model">event.type</field>
        <field name="inherit_id" ref="event.view_event_type_form" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="privacy_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="event_event_view_form_inherit_privacy" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.privacy</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="privacy_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
