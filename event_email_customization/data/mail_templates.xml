        <record id="event_waiting_custom" model="mail.template">
            <field name="name">Event: Custom Waiting List Confirmation</field>
            <field name="model_id" ref="event.model_event_registration" />
            <field
                name="subject"
            >Custom Waiting List: {{ object.event_id.name }}</field>
            <field
                name="email_from"
            >{{ (object.event_id.organizer_id.email_formatted or object.event_id.user_id.email_formatted or '') }}</field>
            <field
                name="email_to"
            >{{ (object.email and '"%s" &lt;%s&gt;' % (object.name, object.email) or object.partner_id.email_formatted or '') }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hei <t t-out="object.name or 'Guest'" />,</p>
                    <p>Kiitos kiinnostuksestasi koulustamme kohtaan.
                    Kouluts <strong><t
                                t-out="object.event_id.name or ''"
                            /></strong> on tällä hetkellä täynnä.</p>
                    <p
                    >Sinut on laitettu jonotuslistalle. Olemme sinuun yhteydessä, jos paikkoja vapautuu.</p>
                    <p>Terveisin,</p>
                    <p>TAKK</p>
                </div>
            </field>
            <field name="lang">fi_FI</field>
            <field name="auto_delete" eval="True" />
        </record>

        <record id="event_confirm_waiting_custom" model="mail.template">
            <field name="name">Event: Custom Waiting List Open Seats</field>
            <field name="model_id" ref="event.model_event_registration" />
            <field
                name="subject"
            >Custom Available Slots: {{ object.event_id.name }}</field>
            <field
                name="email_from"
            >{{ (object.event_id.organizer_id.email_formatted or object.event_id.user_id.email_formatted or '') }}</field>
            <field
                name="email_to"
            >{{ (object.email and '"%s" &lt;%s&gt;' % (object.name, object.email) or object.partner_id.email_formatted or '') }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hei <t t-out="object.name or 'Guest'" />,</p>
                    <p>meillä on vapautunut paikkoja koulutukseen <strong><t
                                t-out="object.event_id.name or ''"
                            /></strong>.</p>
                    <p
                    >Vahvista paikkasi nopeasti, ne jaetaan vahvistamisjärjestyksessä.</p>
                    <p>Terveisin,</p>
                    <p>TAKK</p>
                </div>
            </field>
            <field name="lang">fi_FI</field>
            <field name="auto_delete" eval="True" />
        </record>

        <record id="event_company_invitation" model="mail.template">
            <field name="name">Event: Company Invitation</field>
            <field name="model_id" ref="event.model_event_registration" />
            <field name="subject">Invitation: {{ object.event_id.name }}</field>
            <field
                name="email_from"
            >{{ object.event_id.organizer_id.email or object.event_id.user_id.email or '' }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hei!</p>
                    <p>Sinut on kutsuttu osallistumaan koulutukseen: <strong><t
                                t-out="object.event_id.name or ''"
                            /></strong></p>
                    <p>Koulutus pidetään
                    <t
                            t-out="object.event_id.start_date.strftime('%d.%m.%Y klo %H:%M') or ''"
                        /> -
                    <t
                            t-out="object.event_id.end_date.strftime('%d.%m.%Y klo %H:%M') or ''"
                        /> osoitteessa
                    <t t-out="object.event_id.location or ''" />
                    </p>
                    <p>Hyväksyäksesi kutsun, klikkaa alla olevaa linkkiä.</p>
                    <p><a href="object.event_id.">Hyväksy kutsu</a></p>
                    <p>Tervetuloa koulutukseen!</p>
                    <p>TAKK</p>
                </div>
            </field>
            <field name="lang">fi_FI</field>
            <field name="auto_delete" eval="True" />
        </record>

        <record id="event_moodle_invitation" model="mail.template">
            <field name="name">Event: Moodle Invitation</field>
            <field name="model_id" ref="event.model_event_registration" />
            <field
                name="subject"
            >Koulutus: {{ object.event_id.name }} Moodle kutsu</field>
            <field
                name="email_from"
            >{{ object.event_id.organizer_id.email or object.event_id.user_id.email or '' }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hei {{ object.name or 'Guest' }},</p>
                    <p>Sinut on lisätty koulutukseen: <strong><t
                                t-out="object.event_id.name or ''"
                            /></strong></p>
                    <p>voit siirtyä koulutukseen painamalla alla olevaa painiketta.</p>
                    <p><a href="object.event_id.">Hyväksy kutsu</a></p>
                    <p>Ystävällisin terveisin,</p>
                    <p>TAKK</p>
                </div>
            </field>
            <field name="lang">fi_FI</field>
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>
