"                                        course <t t-out=\"object.event_id.name or ''\"></t>.\n"
"                                    </span>\n"
"                                    <p>Hello <strong><t t-out=\"object.attendee_partner_id.name or object.partner_id.name\"></t></strong>,</p>\n"
