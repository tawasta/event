#. module: event_email_customization
#: model:mail.template,body_html:event_email_customization.event_company_invitation_custom
msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"                <tr><td align=\"center\">\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"                        <tbody>\n"
"                            <!-- HEADER -->\n"
"                            <tr>\n"
"                                <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                    <span style=\"font-size: 20px; font-weight: bold;\">\n"
"                                        Sinut on kutsuttu osallistumaan koulutukseen: <t t-out=\"object.event_id.name or ''\"></t>\n"
"                                    </span>\n"
"                                    <p t-if=\"object.event_id.show_date_time or object.event_id.show_location\">\n"
"                                        Koulutus pidetään\n"
"                                        <t t-if=\"object.event_id.show_date_time\">\n"
"                                            :\n"
"                                            <t t-out=\"object.event_id.date_begin_located or ''\"></t> -\n"
"                                            <t t-out=\"object.event_id.date_end_located or ''\"></t>\n"
"                                        </t>\n"
"                                        <t t-if=\"object.event_id.show_location\">\n"
"                                            osoitteessa\n"
"                                            <t t-out=\"object.event_id.address_id.name or 'Online'\"></t>\n"
"                                        </t>\n"
"                                    </p>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <!-- INVITATION DETAILS -->\n"
"                            <tr>\n"
"                                <td style=\"text-align:center;\">\n"
"                                    <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;\">\n"
"                                    <div style=\"font-size: 14px;\">\n"
"                                        Hyväksyäksesi kutsun, klikkaa alla olevaa linkkiä:\n"
"                                        <br><br>\n"
"                                        <a t-attf-href=\"/event/{{ object.event_id.id }}/invitation/{{ object.invite_id.id }}/accept?access_token={{ object.invite_id.access_token }}\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\" target=\"_blank\">\n"
"                                            Hyväksy kutsu\n"
"                                        </a>\n"
"                                    </div>\n"
"                                    <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;\">\n"
"                                </td>\n"
"                            </tr>\n"
"                            <!-- FOOTER -->\n"
"                            <tr>\n"
"                                <td style=\"font-size: 14px;\">\n"
"                                    <p>Tervetuloa koulutukseen!</p>\n"
"                                    <p>\n"
"                                        Ystävällisin terveisin,<br>\n"
"                                        TAKK\n"
"                                    </p>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </td></tr>\n"
"            </table>\n"
"        "
msgstr ""

#. module: event_email_customization
#: model:mail.template,body_html:event_email_customization.event_moodle_invitation_custom
msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"                <tr><td align=\"center\">\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"                        <tbody>\n"
"                            <!-- HEADER -->\n"
"                            <tr>\n"
"                                <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                    <span style=\"font-size: 20px; font-weight: bold;\">\n"
"                                        Sinut on lisätty koulutukseen: <t t-out=\"object.event_id.name or ''\"></t>\n"
"                                    </span>\n"
"                                    <p>Hei <strong><t t-out=\"object.attendee_partner_id.name or object.partner_id.name\"></t></strong>,</p>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"text-align:center;\">\n"
"                                    <div style=\"font-size: 14px;\">\n"
"                                        Voit siirtyä koulutukseen painamalla alla olevaa painiketta:\n"
"                                        <br><br>\n"
"                                        <a t-att-href=\"object.env['moodle.binding'].sudo().get_course_url(object.event_id.moodle_course_id)\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\" target=\"_blank\">\n"
"                                            Siirry koulutukseen\n"
"                                        </a>\n"
"                                    </div>\n"
"                                    <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;\">\n"
"                                </td>\n"
"                            </tr>\n"
"                            <!-- FOOTER -->\n"
"                            <tr>\n"
"                                <td style=\"font-size: 14px;\">\n"
"                                    <p>\n"
"                                        Ystävällisin terveisin,<br>\n"
"                                        TAKK\n"
"                                    </p>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </td></tr>\n"
"            </table>\n"
"        "
msgstr ""

