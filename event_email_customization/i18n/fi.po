#. module: event_email_customization
#: model_terms:ir.ui.view,arch_db:event_email_customization.view_email_template_waiting_list
msgid ""
",\n"
"                is currently full.<br/>\n"
"                You have been added to the waiting list. We will contact you if places become available.<br/><br/>"
msgstr ""
",\n"
"                on tällä hetkellä täynnä.<br/>\n"
"                Sinut on laitettu jonotuslistalle. Olemme sinuun yhteydessä, jos paikkoja vapautuu.<br/>\n"
"                <br/>"

#. module: event_email_customization
#: model_terms:ir.ui.view,arch_db:event_email_customization.view_email_template_subscription_with_cancel
msgid ""
",<br/><br/>\n"
"                    Your registration for the course"
msgstr ""
",<br/><br/>\n"
"                ilmoittautumisesi koulutukseen"

#. module: event_email_customization
#: model_terms:ir.ui.view,arch_db:event_email_customization.view_email_template_confirm_waiting_list
msgid ""
",<br/><br/>\n"
"                Places have become available on the training course"
msgstr ""
",<br/><br/>\n"
"                meillä on vapautunut paikkoja koulutukseen"

#. module: event_email_customization
#: model_terms:ir.ui.view,arch_db:event_email_customization.view_email_template_waiting_list
msgid ""
",<br/><br/>\n"
"                Thank you for your interest in our training course.<br/>\n"
"                The course"
msgstr ""
",<br/><br/>\n"
"                kiitos kiinnostuksestasi koulutustamme kohtaan.<br/>\n"
"                Koulutus"

#. module: event_email_customization
#: model_terms:ir.ui.view,arch_db:event_email_customization.view_email_template_reminder_with_cancel
msgid ""
",<br/><br/>\n"
"                This is a reminder that the training course"
msgstr ""
",<br/><br/>\n"
"                muistathan, että koulutus"

#. module: event_email_customization
#: model_terms:ir.ui.view,arch_db:event_email_customization.view_email_template_subscription_with_cancel
msgid ""
".\n"
"                    <br/><br/>\n"
"                    You can now invite other participants to join the course. Click the link below to manage your invitations:\n"
"                    <br/><br/>"
msgstr ""
".\n"
"                    <br/><br/>\n"
"                    Voit nyt kutsua muita osallistujia mukaan koulutukseen. Klikkaa alla olevaa linkkiä hallitaksesi kutsujasi:\n"
"                    <br/><br/>"

#. module: event_email_customization
#: model_terms:ir.ui.view,arch_db:event_email_customization.view_email_template_confirm_waiting_list
msgid ""
".<br/>\n"
"                Please confirm your place as soon as possible. Places will be allocated in the order confirmations are received.<br/><br/>"
msgstr ""
".<br/>\n"
"                Vahvista paikkasi nopeasti, ne jaetaan vahvistamisjärjestyksessä.<br/><br/>"

