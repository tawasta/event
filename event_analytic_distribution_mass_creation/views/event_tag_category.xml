<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_tag_category_view_tree" model="ir.ui.view">
        <field
            name="name"
        >event.tag.category.view.tree.inherit.analytic.accounting.rule</field>
        <field name="model">event.tag.category</field>
        <field name="inherit_id" ref="event.event_tag_category_view_tree" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="use_in_analytic_accounting_rules" optional="show" />
            </field>
        </field>
    </record>

    <record id="event_tag_category_view_form" model="ir.ui.view">
        <field
            name="name"
        >event.tag.category.view.form.inherit.analytic.accounting.rule</field>
        <field name="model">event.tag.category</field>
        <field name="inherit_id" ref="event.event_tag_category_view_form" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="before">
                <field name="use_in_analytic_accounting_rules" />
            </field>
        </field>
    </record>
</odoo>
