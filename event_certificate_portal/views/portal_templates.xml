<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="portal_my_events_inherit_certificate"
        inherit_id="website_my_events.portal_my_events"
    >
        <xpath expr="//td[contains(@class, 'table-cell-action')]/div" position="inside">
            <t t-if="re.event_id.certificate_enabled and re.state == 'done'">
                <a
                    t-attf-href="/my/events/registration/{{ re.id }}/certificate"
                    class="btn btn-outline-primary btn-sm"
                    target="_blank"
                >
                    <i class="fa fa-download me-1" aria-hidden="true" />
                    <span>Download certificate</span>
                </a>
            </t>
        </xpath>
    </template>
</odoo>
