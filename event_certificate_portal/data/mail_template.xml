<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_event_certificate" model="mail.template">
        <field name="name">Event Certificate Email</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="subject">Attendance Certificate: {{ object.event_id.name }}</field>
        <field name="email_from">{{ object.event_id.company_id.email_formatted or object.event_id.organizer_id.email_formatted or object.event_id.user_id.email_formatted or '' }}</field>
        <field name="email_to">{{ object._get_certificate_email_to() or '' }}</field>
        <field name="lang">{{ object.partner_id.lang or object.visitor_id.lang_id.code or user.lang }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.name"/>,</p>

                <p>
                    Thank you for participating in the event
                    <strong><t t-out="object.event_id.name"/></strong>.
                </p>

                <p>
                    Your attendance certificate is attached as a PDF.
                </p>

                <p>
                    The certificate is also available in the portal:
                    <a t-att-href="object.get_base_url() + object._build_certificate_portal_url()">open certificate</a>
                </p>

                <p>
                    Best regards,<br/>
                    <t t-out="object.event_id.company_id.name"/>
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>