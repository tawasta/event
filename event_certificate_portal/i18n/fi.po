#. module: event_certificate_portal
#: model:ir.actions.report,print_report_name:event_certificate_portal.action_report_event_certificate
msgid ""
"'Attendance Certificate - %s' % ((object.name or object.partner_id.name or "
"'certificate').replace('/', '-'))"
msgstr ""
"'Osallistumistodistus - %s' % ((object.name or object.partner_id.name or "
"'todistus').replace('/', '-'))"

#. module: event_certificate_portal
#: model:mail.template,body_html:event_certificate_portal.email_template_event_certificate
msgid ""
"<div>\n"
"                <p>Hello <t t-out=\"object.name\"></t>,</p>\n"
"\n"
"                <p>\n"
"                    Thank you for participating in the event\n"
"                    <strong><t t-out=\"object.event_id.name\"></t></strong>.\n"
"                </p>\n"
"\n"
"                <p>\n"
"                    Your attendance certificate is attached as a PDF.\n"
"                </p>\n"
"\n"
"                <p>\n"
"                    The certificate is also available in the portal:\n"
"                    <a t-att-href=\"object.get_base_url() + object._build_certificate_portal_url()\">open certificate</a>\n"
"                </p>\n"
"\n"
"                <p>\n"
"                    Best regards,<br>\n"
"                    <t t-out=\"object.event_id.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">Hei <t t-out=\"object.name\"></t>,</p>\n"
"\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"                    Kiitos osallistumisestasi tapahtumaan\n"
"                    <strong style=\"box-sizing:border-box;font-weight:bolder;\"><t t-out=\"object.event_id.name\"></t></strong>.\n"
"                </p>\n"
"\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"                    Osallistumistodistuksesi on liitteenä PDF-muodossa.\n"
"                </p>\n"
"\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"                    Todistus on saatavilla myös portaalissa:\n"
"                    <a t-att-href=\"object.get_base_url() + object._build_certificate_portal_url()\" style=\"text-decoration: none; box-sizing: border-box; color: #495057;\">avaa todistus</a>\n"
"                </p>\n"
"\n"
"                <p style=\"margin:0px 0 16px 0;box-sizing:border-box;\">\n"
"                    Ystävällisin terveisin,<br>\n"
"                    <t t-out=\"object.event_id.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "

