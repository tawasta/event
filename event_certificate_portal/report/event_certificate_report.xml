<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_event_certificate" model="ir.actions.report">
        <field name="name">Attendance Certificate</field>
        <field name="model">event.registration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">event_certificate_portal.event_certificate_pdf</field>
        <field name="report_file">event_certificate_portal.event_certificate_pdf</field>
        <field
            name="paperformat_id"
            ref="event_certificate_portal.paperformat_event_certificate"
        />
        <field
            name="print_report_name"
        >'Attendance Certificate - %s' % ((object.name or object.partner_id.name or 'certificate').replace('/', '-'))</field>
        <field name="binding_model_id" ref="event.model_event_registration" />
        <field name="binding_type">report</field>
    </record>

    <template id="event_certificate_pdf">
        <t t-foreach="docs" t-as="reg">
            <t t-set="cert_lang" t-value="reg.event_id.certificate_lang or env.lang" />
            <t t-call="web.basic_layout">
                <div class="page">
                    <t
                        t-call="event_certificate_portal.event_certificate_page"
                        t-lang="reg.event_id.certificate_lang or env.lang"
                    />
                </div>
            </t>
        </t>
    </template>

    <template id="event_certificate_page">
        <t t-set="event" t-value="reg.event_id" />
        <t t-set="company" t-value="event.company_id or env.company" />
        <t
            t-set="participant_name"
            t-value="reg.name or reg.partner_id.name or ((reg.visitor_id and reg.visitor_id.partner_id) and reg.visitor_id.partner_id.name) or ''"
        />
        <t
            t-set="event_date_text"
            t-value="event.date_begin and context_timestamp(event.date_begin).strftime('%d.%m.%Y') or ''"
        />
        <t
            t-set="today_text"
            t-value="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y')"
        />
        <t t-set="city_text" t-value="company.city or ''" />
        <t t-set="duration_text" t-value="event.certificate_duration_text or ''" />
        <t t-set="lecturer_name" t-value="event.certificate_lecturer_id.name or ''" />
        <t
            t-set="signatory_name"
            t-value="company.event_certificate_signatory_name or ''"
        />
        <t
            t-set="signatory_title"
            t-value="company.event_certificate_signatory_title or ''"
        />

        <div
            class="page"
            style="position: relative; min-height: 1120px; font-family: Arial, Helvetica, sans-serif; color: #111111;"
        >

            <!-- Top logo: only company logo here -->
            <div style="text-align: center; margin-top: 55px;">
                <img
                    t-if="company.logo"
                    t-att-src="image_data_uri(company.logo)"
                    alt="Company logo"
                    style="max-height: 150px; max-width: 220px;"
                />
            </div>

            <!-- Title -->
            <div style="text-align: center; margin-top: 26px;">
                <div style="font-size: 24px; font-weight: 500;">
                    ATTENDANCE CERTIFICATE
                </div>
            </div>

            <!-- Main content -->
            <div
                style="text-align: center; font-size: 15px; line-height: 1.22; margin-top: 78px;"
            >

                <div>
                    <span>Participant: </span>
                    <span t-esc="participant_name" />
                </div>

                <div style="margin-top: 58px;">
                    <div>Event:</div>
                    <div style="margin-top: 4px;" t-esc="event.name" />
                </div>

                <div style="margin-top: 36px;">
                    <span>Date: </span>
                    <span t-esc="event_date_text" />
                    <t t-if="duration_text">
                        <span> / </span>
                        <span t-esc="duration_text" />
                    </t>
                </div>
                <t
                    t-set="program_text"
                    t-value="event.certificate_program_text or ''"
                />
                <div t-if="program_text" style="margin-top: 30px;">
                    <div>Training programme:</div>
                    <div
                        style="margin-top: 4px; white-space: pre-line;"
                        t-esc="program_text"
                    />
                </div>

                <div t-if="lecturer_name" style="margin-top: 38px;">
                    <div>Lecturer:</div>
                    <div style="margin-top: 4px;" t-esc="lecturer_name" />
                </div>
            </div>

            <!-- Signature date/place -->
            <div style="text-align: center; margin-top: 130px; font-size: 14px;">
                <t t-if="city_text">
                    <span t-esc="city_text" />
                    <span> </span>
                </t>
                <span t-esc="today_text" />
            </div>

            <!-- Signature image: only signature here -->
            <div style="text-align: center; margin-top: 14px; min-height: 95px;">
                <img
                    t-if="company.event_certificate_signature"
                    t-att-src="image_data_uri(company.event_certificate_signature)"
                    alt="Signature"
                    style="max-height: 90px; max-width: 190px;"
                />
            </div>

            <!-- Signatory -->
            <div
                style="text-align: center; font-size: 14px; line-height: 1.2; margin-top: 2px;"
            >
                <div t-esc="signatory_name" />
                <div t-esc="signatory_title" />
            </div>

            <!-- Organization line above footer -->
            <div style="text-align: center; font-size: 13px; margin-top: 18px;">
                <span t-esc="company.name" />
            </div>

            <!-- Footer -->
            <div
                style="position: absolute; left: 0; right: 0; bottom: 24px; text-align: center; font-size: 12px; color: #111111;"
            >
                <span t-esc="company.name" />
                <t
                    t-if="company.street or company.street2 or company.zip or company.city"
                >
                    <span style="display: inline-block; margin-left: 28px;" />
                    <span
                        t-esc="' '.join(filter(None, [company.street or '', company.street2 or '', (company.zip or ''), (company.city or '')]))"
                    />
                </t>
                <t t-if="company.email">
                    <span style="display: inline-block; margin-left: 28px;" />
                    <span t-esc="company.email" />
                </t>
            </div>
        </div>
    </template>
</odoo>
