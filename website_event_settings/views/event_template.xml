<?xml version="1.0" ?>
<odoo>
    <template
        id="event_description_full_inherit"
        inherit_id="website_event.event_description_full"
        name="Event Description - Boolean Fields"
    >
        <!-- Date & Time Block -->
        <xpath
            expr="//div[@class='o_wevent_sidebar_block border-bottom pb-3 my-3']"
            position="attributes"
        >
            <attribute name="t-if">event.show_date_time</attribute>
        </xpath>
        <xpath
            expr="//div[@class='d-lg-flex justify-content-end col-lg-4 col-xl-3 mb-3 mb-lg-0 d-print-none']/div[@class='mt-3']"
            position="attributes"
        >
            <attribute
                name="t-attf-class"
            >mt-3#{' col-12' if not event.show_date_time else ''}</attribute>
        </xpath>

        <!-- Location Block -->
        <xpath expr="//div[@itemprop='location']/.." position="attributes">
            <attribute name="t-if">event.show_location</attribute>
        </xpath>

        <!-- Share Block -->
        <xpath expr="//t[@t-snippet-call='website.s_share']/.." position="attributes">
            <attribute name="t-if">event.show_share</attribute>
        </xpath>

    </template>

    <!-- Apply the same show_date_time setting to the "Upcoming Events"
         dynamic snippet's Card Layout -->
    <template
        id="dynamic_filter_template_event_event_card_inherit"
        inherit_id="website_event.dynamic_filter_template_event_event_card"
        name="Event Card Layout - Boolean Fields"
    >
        <xpath expr="//time[@itemprop='startDate']" position="attributes">
            <attribute name="t-if">record.show_date_time</attribute>
        </xpath>
        <xpath
            expr="//div[@class='s_events_event_date position-absolute shadow-sm text-dark']"
            position="attributes"
        >
            <attribute name="t-if">record.show_date_time</attribute>
        </xpath>
    </template>

    <!-- Apply the same show_date_time setting to the events list page's
         (/event) short date badge on each event's cover image -->
    <template
        id="events_list_inherit"
        inherit_id="website_event.events_list"
        name="Events List - Boolean Fields"
    >
        <xpath
            expr="//div[contains(@t-attf-class, 'o_wevent_event_date')]"
            position="attributes"
        >
            <attribute name="t-if">event.show_date_time</attribute>
        </xpath>
    </template>
</odoo>
