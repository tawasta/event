#. module: event_registration_survey_recap_mail_after_registration
#: model:mail.template,body_html:event_registration_survey_recap_mail_after_registration.mail_template_event_registration_survey_recap
msgid ""
"\n"
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Dear {{ object.name or 'Participant' }},</p>\n"
"    <p>\n"
"        Thank you for registering for\n"
"        <strong>{{ object.event_id.name }}</strong>.\n"
"    </p>\n"
"    <p>\n"
"        All your survey responses have been processed.\n"
"        Below is a summary of the surveys completed:\n"
"    </p>\n"
"    <ul>\n"
"        {% for answer in object.survey_answer_ids %}\n"
"        <li>{{ answer.survey_id.title }}</li>\n"
"        {% endfor %}\n"
"    </ul>\n"
"    <p>Kind regards,<br/>\n"
"        {{ object.event_id.organizer_id.name or object.company_id.name }}\n"
"    </p>\n"
"</div>\n"
msgstr ""
"\n"
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Hei {{ object.name or 'Participant' }},</p>\n"
"    <p>\n"
"        Kiitos ilmoittautumisestasi tapahtumaan \n"
"        <strong>{{ object.event_id.name }}</strong>.\n"
"    </p>\n"
"    <p>\n"
"        Ohessa vielä yhteenveto ilmoittautumisen yhteydessä syöttämistäsi tiedoista:\n"
"    </p>\n"
"    <ul>\n"
"        {% for answer in object.survey_answer_ids %}\n"
"        <li>{{ answer.survey_id.title }}</li>\n"
"        {% endfor %}\n"
"    </ul>\n"
"    <p>Terveisin,<br/>\n"
"        {{ object.event_id.organizer_id.name or object.company_id.name }}\n"
"    </p>\n"
"</div>\n"

