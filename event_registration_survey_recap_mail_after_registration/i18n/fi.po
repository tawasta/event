#. module: event_registration_survey_recap_mail_after_registration
#: model_terms:ir.ui.view,arch_db:event_registration_survey_recap_mail_after_registration.res_config_settings_view_form_inherit_survey_recap
msgid ""
"Email template sent to registrants once all linked\n"
"                                survey answers have been processed."
msgstr ""
"Sähköpostipohja, joka lähetetään tapahtuman osallistujille, kun kaikki liittyvät kyselyvastaukset on saatu käsiteltyä."

#. module: event_registration_survey_recap_mail_after_registration
#: model:ir.model.fields,help:event_registration_survey_recap_mail_after_registration.field_res_config_settings__survey_recap_email_template_id
msgid ""
"Email template sent to registrants once all survey answers have been "
"processed. Leave empty to use the default template."
msgstr ""
"Sähköpostipohja, joka lähetetään tapahtuman osallistujille, kun kaikki liittyvät kyselyvastaukset on saatu käsiteltyä. "
"Jätä tyhjäksi käyttääksesi yksinkertaista oletuspohjaa."

