<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_event_track_tree_inherit" model="ir.ui.view">
        <field
            name="name"
        >view.event.track.tree.inherit.sessions.editable.in.treeview</field>
        <field name="model">event.track</field>
        <field
            name="inherit_id"
            ref="website_event_track_advanced.view_event_track_tree"
        />
        <field name="arch" type="xml">

            <xpath expr="//tree" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>

            <field name="location_id" position="after">
                <field name="duration" optional="show" />
            </field>

            <field name="activity_exception_decoration" position="before">
                <field name="tag_ids" optional="show" widget="many2many_tags" />
            </field>

            <field name="activity_exception_decoration" position="after">
                <button
                    name="action_open_form"
                    type="object"
                    icon="fa-external-link"
                    string="Session Full Details"
                    title="Session Full Details"
                />
            </field>
        </field>
    </record>
</odoo>
