<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="events_list" inherit_id="website_event.events_list">
        <xpath expr="//div[@id='event_details']" position="inside">
            <div t-if="event.start_sale_datetime" class="mt-1">
                <small class="text-muted">Registrations open: <span
                        t-out="event.start_sale_datetime"
                        t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'dd.MM.yyyy HH:mm'}"
                    /></small>
            </div>
        </xpath>
    </template>

</odoo>
