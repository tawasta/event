<?xml version="1.0" ?>
<odoo>
  <record id="act_event_feedback_answers_from_event" model="ir.actions.act_window">
    <field name="res_model">survey.user_input</field>
    <field name="name">Feedback Answers</field>
    <field name="view_mode">list,form,pivot</field>
    <field name="domain">[('feedback_event_id', '=', active_id)]</field>
    <field name="context">{'default_feedback_event_id': active_id}</field>
  </record>

  <record id="event_view_form_inherit_feedback" model="ir.ui.view">
    <field name="name">event.event.view.form.inherit.feedback</field>
    <field name="model">event.event</field>
    <field name="inherit_id" ref="event.view_event_form" />
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button
          name="%(event_survey_feedback.act_event_feedback_answers_from_event)d"
          type="action"
          class="oe_stat_button"
          icon="fa-comments"
          help="Answered feedback surveys for this Event"
          invisible="not feedback_survey_id"
        >
          <field name="feedback_answer_count" widget="statinfo" string="Feedback" />
        </button>
      </div>
      <xpath expr="//field[@name='seats_limited']/parent::div" position="after">
        <field name="feedback_survey_id" />
        <field name="survey_start_url" invisible="not feedback_survey_id" />
      </xpath>
    </field>
  </record>
</odoo>
