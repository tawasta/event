<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.event.purchase.options.confirmation</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="event_ticket_purchase_options.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <setting id="event_registration_others_help_setting" position="after">
                <setting
                    id="event_invitation_confirmation_help_setting"
                    string="Instructions on order confirmation"
                    help="Shown in the registrations box of the order confirmation page, e.g. where the registrations are found and how the other participants are invited. Leave empty to hide the instructions."
                >
                    <!-- The wrapper lets the editor use the full column width -->
                    <div>
                        <field
                            name="event_invitation_confirmation_help"
                            class="w-100"
                            placeholder="E.g. your registrations are on the Events page of your account. If you registered other participants, send each of them an invitation there..."
                        />
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
