<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="confirmation"
        inherit_id="website_sale.confirmation"
        name="Event Invitations on Order Confirmation"
    >
        <xpath
            expr="//div[@id='oe_structure_website_sale_confirmation_1']"
            position="before"
        >
            <div
                t-if="event_invitation"
                id="event_invitation_confirmation"
                class="card mt-3"
                role="note"
                aria-labelledby="event_invitation_confirmation_title"
            >
                <div class="card-body">
                    <h5 id="event_invitation_confirmation_title" class="card-title">
                        <i
                            class="fa fa-users text-primary me-2"
                            aria-hidden="true"
                        />Invite the other participants
                    </h5>
                    <!-- The class gives editor HTML the same block spacing as the
                         registration option help -->
                    <div
                        t-if="event_invitation['help']"
                        class="o_registration_choice_help_text mb-3"
                        t-out="event_invitation['help']"
                    />
                    <t t-if="not event_invitation['is_confirmed']">
                        <p class="mb-0 text-muted">
                            You can send the invitations once your payment has been confirmed.
                        </p>
                    </t>
                    <t t-elif="event_invitation.get('url')">
                        <a
                            role="button"
                            class="btn btn-primary"
                            t-att-href="event_invitation['url']"
                        >
                            <t
                                t-if="event_invitation['access'] == 'signup'"
                            >Create an account and send invitations</t>
                            <t
                                t-elif="event_invitation['access'] == 'login'"
                            >Log in and send invitations</t>
                            <t t-else="">Send invitations</t>
                            <i class="fa fa-arrow-right ms-2" aria-hidden="true" />
                        </a>
                    </t>
                    <t t-else="">
                        <p class="mb-0 text-muted">
                            The invitations are sent from the Events page of your customer account.
                        </p>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
