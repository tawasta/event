<?xml version="1.0" ?>
<odoo>
  <record id="view_event_form_website_published" model="ir.ui.view">
    <field name="name">event.event.form.website.published</field>
    <field name="model">event.event</field>
    <field name="inherit_id" ref="website_event.event_event_view_form" />
    <field name="arch" type="xml">
      <!-- Core keeps the field hidden next to the visibility of the event -->
      <xpath
        expr="//group[@name='right_event_details']/field[@name='website_published']"
        position="attributes"
      >
        <attribute name="invisible">0</attribute>
        <attribute name="string">Published</attribute>
        <attribute name="widget">boolean_toggle</attribute>
      </xpath>
    </field>
  </record>
</odoo>
