<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- A privilege of its own, so that the group is an add-on to the event roles
         and is shown in the user form (the groups of one privilege are exclusive) -->
    <record id="res_groups_privilege_publish_event_near_future" model="res.groups.privilege">
        <field name="name">Event Publishing in Near Future</field>
        <field name="sequence">19</field>
        <field name="category_id" ref="base.module_category_marketing" />
    </record>

    <record id="group_publish_event_in_near_future" model="res.groups">
        <field name="name">Publish Events that are &lt; 30 days away on Website</field>
        <field
            name="privilege_id"
            ref="event_ticket_registration_control.res_groups_privilege_publish_event_near_future"
        />
    </record>

</odoo>
