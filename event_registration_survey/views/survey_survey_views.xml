<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="survey_form_event" model="ir.ui.view">
        <field name="name">Form view for survey</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='questions']" position="after">
                <page string="Events" name="events">
                    <group>
                        <field name="is_event_survey" />
                        <field name="default_survey" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
