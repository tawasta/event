<?xml version="1.0" ?>
<odoo>
    <!-- SURVEY ACTIONS -->
    <record id="act_event_survey_answers_from_event" model="ir.actions.act_window">
        <field name="res_model">survey.user_input.line</field>
        <field name="name">Answers</field>
        <field name="view_mode">list,form,pivot</field>
        <field
            name="domain"
        >[('event_id', '=', active_id), ('registration_id.state', '!=', 'cancel')]</field>
        <field
            name="context"
        >{'default_event_id': active_id, 'search_default_group_by_event_registration': 1}</field>
    </record>
    <record id="act_event_survey_answer_sheet_from_event" model="ir.actions.act_window">
        <field name="res_model">survey.user_input</field>
        <field name="name">Answer Sheet</field>
        <field name="view_mode">list,form,pivot</field>
        <field
            name="domain"
        >[('event_id', '=', active_id), ('registration_id.state', '!=', 'cancel')]</field>
        <field name="context">{'default_event_id': active_id }</field>
    </record>
    <!-- EVENT.TYPE VIEWS -->
    <record id="event_type_view_form_inherit_survey" model="ir.ui.view">
        <field name="name">event.type.view.form.inherit.survey</field>
        <field name="model">event.type</field>
        <field name="priority" eval="99" />
        <field name="inherit_id" ref="website_event.event_type_view_form" />
        <field name="arch" type="xml">
            <field name="question_ids" position="replace">
                <field
                    name="survey_ids"
                    nolabel="1"
                    domain="[('is_event_survey', '=', True)]"
                    widget="many2many"
                >
                    <list>
                        <field name="title" />
                        <field name="answer_count" />
                        <field name="answer_done_count" />
                    </list>
                </field>
            </field>
        </field>
    </record>
    <!-- EVENT.EVENT VIEWS -->
    <record id="event_event_view_form_inherit_survey" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.survey</field>
        <field name="model">event.event</field>
        <field name="priority" eval="99" />
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='question_ids']" position="replace">
                <field
                    name="survey_ids"
                    nolabel="1"
                    domain="[('is_event_survey', '=', True)]"
                    widget="many2many"
                >
                    <list>
                        <field name="title" />
                        <field name="answer_count" />
                        <field name="answer_done_count" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="event_event_view_form_answer_sheet_button" model="ir.ui.view">
        <field name="name">event.event.view.form.answer.sheet.button</field>
        <field name="model">event.event</field>
        <field name="priority" eval="99" />
        <field
            name="inherit_id"
            ref="website_event_questions_view.event_event_view_form_questions_list"
        />
        <field name="arch" type="xml">
            <xpath expr="//button[@id='question_answers_button']" position="attributes">
                <attribute
                    name="name"
                >%(event_registration_survey.act_event_survey_answers_from_event)d</attribute>
            </xpath>
            <xpath expr="//button[@id='question_answers_button']" position="before">
                <button
                    name="%(event_registration_survey.act_event_survey_answer_sheet_from_event)d"
                    id="question_answer_sheet_button"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-question-circle"
                    help="Question answer sheet for this Event"
                    invisible="not has_answers"
                >
                    <field
                        name="answer_sheet_count"
                        widget="statinfo"
                        string="Answer Sheet"
                    />
                </button>
            </xpath>
        </field>
    </record>
    <!-- EVENT.REGISTRATION VIEWS -->
    <record id="view_event_registration_form_survey" model="ir.ui.view">
        <field name="name">event.registration.form.survey</field>
        <field name="model">event.registration</field>
        <field name="priority" eval="99" />
        <field name="inherit_id" ref="event.view_event_registration_form" />
        <field name="arch" type="xml">
            <field name="registration_answer_ids" position="replace">
                <field name="survey_answer_ids" />
            </field>
        </field>
    </record>
</odoo>
