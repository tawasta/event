<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_event_form" model="ir.ui.view">
        <field name="name">event.event.form.organizer.contact.info.visibility</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <field name="organizer_id" position="after">

                <field name="organizer_show_on_website" />

                <field
                    name="organizer_show_phone_on_website"
                    invisible="not organizer_show_on_website "
                />
                <field
                    name="organizer_show_mobile_on_website"
                    invisible="not organizer_show_on_website"
                />
                <field
                    name="organizer_show_email_on_website"
                    invisible="not organizer_show_on_website"
                />
            </field>
        </field>
    </record>
</odoo>
